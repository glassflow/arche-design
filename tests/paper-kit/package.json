    "@radix-ui/react-tabs": "1.2.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "jsdom": "27.0.1",
